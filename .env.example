# Set these in your shell or your host's settings; the launcher does not load this file.
# Names and shapes only. Never commit real values.

# --- Backend (FastAPI) ---
DATABASE_URL=postgresql+psycopg://finsight:local_only_change_me@localhost:5432/finsight
# Deployment: a random 32+ character secret, the same value the web app sends. Required unless FINSIGHT_INSECURE_DEV=1.
FINSIGHT_API_KEY=
# Local development only: allow keyless API access and /docs. Leave unset in any deployment.
# FINSIGHT_INSECURE_DEV=1
# Deployment: the hostname(s) the API is served on, comma-separated.
# ALLOWED_HOSTS=api.example.com

# --- Web app (Next.js) ---
# Base URL of the backend. Local development: http://127.0.0.1:8000. In production it must be HTTPS or the proxy answers 503.
API_URL=https://api.example.com
# Workspace password (16+ characters) and cookie-signing secret (32+ characters). With the password unset and
# NODE_ENV not production, the workspace opens without sign-in (local development only).
FINSIGHT_OWNER_PASSWORD=
FINSIGHT_SESSION_SECRET=
